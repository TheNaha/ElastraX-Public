# ╔═══════════════════════════════════════════════════════════════════════╗
# ║                    ElastraX v7 — Environment Variables               ║
# ╚═══════════════════════════════════════════════════════════════════════╝
# Copy this file to `.env` and fill in the values for your deployment.
# Lines starting with # are comments; uncomment to enable.

# ─── Bot Identity & Ownership ──────────────────────────────────────────
# Custom SQLite database path (default: ./data/bot.db)
# ELASTRAX_DB_PATH="./data/bot.db"

# Full WhatsApp JID of the bot owner. This user gets implicit `owner`
# permission everywhere and can grant/revoke roles via /role.
BOT_OWNER_JID="6281234567890@s.whatsapp.net"

# ─── AI / LLM — Single Provider Mode ──────────────────────────────────
# Used when AI_PROVIDERS is NOT set. All three are required.
AI_API_BASE_URL=""
AI_API_KEY="dummy_key_for_now"
AI_MODEL_NAME="cyankiwi/Qwen3-Omni-30B-A3B-Instruct-AWQ-4bit"

# Example: Modal deployment
# AI_API_BASE_URL="https://<workspace>--elastra-gpbot-vllm-model-serve.modal.run/v1"
# AI_MODEL_NAME="cyankiwi/Qwen3-Omni-30B-A3B-Instruct-AWQ-4bit"

# Example: Google AI Studio (Gemini)
# AI_API_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
# AI_API_KEY="your_gemini_api_key_here"
# AI_MODEL_NAME="gemini-2.5-flash"

# Example: Cloudflare Workers AI (OpenAI-compatible)
# You can use direct OpenAI-compatible base URL:
# AI_API_BASE_URL="https://api.cloudflare.com/client/v4/accounts/<account_id>/ai/v1"
# AI_API_KEY="your_cloudflare_api_token"
# AI_MODEL_NAME="@cf/meta/llama-3.1-8b-instruct"
#
# Or shorthand (auto-builds AI_API_BASE_URL internally):
# AI_CF_ACCOUNT_ID="your_account_id"
# AI_CF_API_TOKEN="your_cloudflare_api_token"

# ─── AI / LLM — Multi-Provider Failover Mode ──────────────────────────
# Comma-separated list of provider names. When set, single-provider vars
# above are ignored and per-provider vars are used instead.
# AI_PROVIDERS="modal,gemini"
#
# Per-provider pattern: AI_<NAME>_BASE_URL, AI_<NAME>_API_KEY, AI_<NAME>_MODEL
# AI_MODAL_BASE_URL="https://<workspace>--elastra-gpbot-vllm-model-serve.modal.run/v1"
# AI_MODAL_API_KEY="dummy"
# AI_MODAL_MODEL="cyankiwi/Qwen3-Omni-30B-A3B-Instruct-AWQ-4bit"
#
# AI_GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
# AI_GEMINI_API_KEY="your_key"
# AI_GEMINI_MODEL="gemini-2.5-flash"
#
# Cloudflare provider (full URL form)
# AI_CLOUDFLARE_BASE_URL="https://api.cloudflare.com/client/v4/accounts/<account_id>/ai/v1"
# AI_CLOUDFLARE_API_KEY="your_cloudflare_api_token"
# AI_CLOUDFLARE_MODEL="@cf/meta/llama-3.1-8b-instruct"
#
# Cloudflare provider (shorthand form)
# AI_CLOUDFLARE_CF_ACCOUNT_ID="your_account_id"
# AI_CLOUDFLARE_CF_API_TOKEN="your_cloudflare_api_token"

# ─── Provider Media Capability Flags (V7.13) ───────────────────────────
# Per-provider flags controlling which media content block types are sent.
# image_url is always sent to all providers; video_url and audio_url are
# only sent to providers that support them (vLLM/Qwen3-Omni style).
# Providers whose name starts with "modal" default to true; all others default to false.
# Set to "true" only if your model explicitly supports that media type.
#
# AI_MODAL1_SUPPORTS_VIDEO=true
# AI_MODAL1_SUPPORTS_AUDIO=true
# AI_POLLINATIONS_SUPPORTS_VIDEO=false
# AI_POLLINATIONS_SUPPORTS_AUDIO=false
# AI_AIRFORCE_SUPPORTS_VIDEO=false
# AI_AIRFORCE_SUPPORTS_AUDIO=false
# AI_CLOUDFLARE_SUPPORTS_VIDEO=false
# AI_CLOUDFLARE_SUPPORTS_AUDIO=false
# AI_OPENROUTER_SUPPORTS_VIDEO=false
# AI_OPENROUTER_SUPPORTS_AUDIO=false
# AI_GROQ_SUPPORTS_VIDEO=false
# AI_GROQ_SUPPORTS_AUDIO=false
# AI_GEMINI_SUPPORTS_VIDEO=false
# AI_GEMINI_SUPPORTS_AUDIO=false

# ─── AI Behaviour Defaults ─────────────────────────────────────────────
# Max tokens per LLM response (default: 2048)
AI_MAX_TOKENS=20480

# Request timeout for LLM calls in milliseconds (default: 60000)
AI_TIMEOUT_MS=120000

# Request timeout specifically for LLM tool calls in milliseconds (default: 30000)
# AI_TOOL_TIMEOUT_MS=30000

# Cooldown duration before retrying a failed AI provider in failover mode (default: 30000)
# AI_PROVIDER_COOLDOWN_MS=30000

# Optional model tier tag. Global: AI_TIER, or per-provider AI_<NAME>_TIER
# (e.g. AI_MODAL_TIER=premium). Tools may use tiers to steer model choice.
# AI_TIER=default

# Print raw AI prompts and responses to the terminal for debugging
# AI_VERBOSE_LOGS=false

# Maximum number of tool-call loop iterations per AI turn (default: 8)
AI_MAX_TOOL_ITERATIONS=8

# Enable real-time streaming updates using message editing (default: false)
# AI_STREAMING=true
# STREAMING_EDIT_INTERVAL_WA=1500  # Milliseconds between edits on WhatsApp (prevent rate limits)
# STREAMING_EDIT_INTERVAL_DC=500   # Milliseconds between edits on Discord

# Tool loading mode for LLM calls (default: "search")
# "search" = Smart mode: only essential tools + triggered ones loaded; AI discovers others via find_tools
# "all"    = Legacy mode: all permitted tools sent in every request (~2000 extra tokens per call)
# Use "all" if you notice the AI asking unnecessary questions or failing to use tools directly.
TOOL_LOADING_MODE="search"

# Default sampling temperature, 0.0–2.0 (default: 0.7)
# Can be overridden per-chat via /config set temperature <value>
AI_TEMPERATURE=0.7

# ─── Conversation Defaults (overridable per-chat via /config) ──────────
# Number of recent messages included in the LLM context window (default: 10)
CONTEXT_MESSAGE_LIMIT=10

# V7.13: Enable LLM-powered conversation history summarization.
# When true (default), old messages are compressed into a rolling summary paragraph
# instead of being dropped, giving the bot effective long-term memory.
# When false, only the most recent CONTEXT_MESSAGE_LIMIT messages are sent.
# Can be overridden per-chat via: /config set summarize true|false
CONTEXT_SUMMARIZE=true

# V7.16: Long-Term Memory (RAG)
# Note: There is no global env var for this, it defaults to TRUE in private DMs 
# and FALSE in group chats. You can override it dynamically per chat:
# /config set longTermMemory true|false

# Set to "true" to make the bot reply to every message in group chats
# by default (not just mentions/replies). Per-chat override via /config.
AUTO_REPLY_ALL=false

# Default system prompt. Use {{LANGUAGE}} as a placeholder for the room language.
# Base version (no media services):
DEFAULT_SYSTEM_PROMPT="You are ElastraX, a helpful and friendly female AI personal assistant.\nYou are communicating via a messaging app (WhatsApp/Discord).\nIf someone asks your name or identity, strictly introduce yourself as ElastraX.\nBe concise but warmly conversational. Use emojis naturally where appropriate, but don't overdo it.\nDo not use markdown formatting that is not supported by WhatsApp (e.g. headers). Bold and italic are fine.\nIf a user asks a question requiring recent information, facts, or news, you MUST use the web_search tool to find the answer.\nWhen using web_search, always provide a summary of the findings first, and then explicitly provide a list of the source URLs you used at the bottom of your message.\n\nCRITICAL LOCALIZATION INSTRUCTION:\nYou MUST respond entirely in the language specified by the user's chat room setting.\nCurrent Room Language: {{LANGUAGE}}"

# ↑ If you have media services configured (SEERR_API_URL / JELLYFIN_API_URL),
# replace DEFAULT_SYSTEM_PROMPT above with the version below that includes the
# media context block so the AI knows how to use those tools:
#
# DEFAULT_SYSTEM_PROMPT="You are ElastraX, a helpful and friendly female AI personal assistant.\nYou are communicating via a messaging app (WhatsApp/Discord).\nIf someone asks your name or identity, strictly introduce yourself as ElastraX.\nBe concise but warmly conversational. Use emojis naturally where appropriate, but don't overdo it.\nDo not use markdown formatting that is not supported by WhatsApp (e.g. headers). Bold and italic are fine.\nIf a user asks a question requiring recent information, facts, or news, you MUST use the web_search tool to find the answer.\nWhen using web_search, always provide a summary of the findings first, and then explicitly provide a list of the source URLs you used at the bottom of your message.\n\nMEDIA SERVICES INTEGRATION:\nThe bot is connected to a media request and streaming platform.\n- Request Website / Request Service: Users can search for and request movies/TV shows to be added to the library.\n- Watch Website / Stream Website: Users can browse the available media library and get direct links to watch content.\n- Users need to link their account first using the media_account tool (/connect command).\n- When users mention wanting to watch something, request something, or ask about movies/TV shows, use the appropriate media tools (media_search, media_request, media_library).\n- Never refer to the backend services by their internal technical names. Use friendly terms: the streaming service, the request system, media library.\n\nCRITICAL LOCALIZATION INSTRUCTION:\nYou MUST respond entirely in the language specified by the user's chat room setting.\nCurrent Room Language: {{LANGUAGE}}"

# ─── Platform Providers ────────────────────────────────────────────────
# Discord bot token. Leave blank or "dummy_token_here" to disable Discord.
DISCORD_BOT_TOKEN="dummy_token_here"

# ─── Rate Limiting (legacy global fallback) ────────────────────────────
# Only read by the legacy RateLimiter.check() path. Per-user limits come from
# role privileges (ROLE_PRIV_* / DB overrides); these two are the fallback
# defaults for users with no privilege data.
# Max messages a non-admin user can send within the window (default: 10)
RATE_LIMIT_MESSAGES=10

# Window duration in seconds (default: 60)
RATE_LIMIT_WINDOW_SEC=60

# ─── Per-Role Privilege Defaults (V7.11) ───────────────────────────────
# Override role defaults via ROLE_PRIV_{ROLE}_{FIELD} env vars.
# -1 = unlimited. These can also be overridden in DB via /role setpriv.
#
ROLE_PRIV_USER_MESSAGES_PER_WINDOW=10
ROLE_PRIV_USER_RATE_WINDOW_SEC=60
ROLE_PRIV_USER_CONTEXT_LIMIT=20
ROLE_PRIV_USER_MAX_DOWNLOAD_MB=25

ROLE_PRIV_PREMIUM_MESSAGES_PER_WINDOW=30
ROLE_PRIV_PREMIUM_CONTEXT_LIMIT=50
ROLE_PRIV_PREMIUM_MAX_DOWNLOAD_MB=100

ROLE_PRIV_ADMIN_MESSAGES_PER_WINDOW=30
ROLE_PRIV_ADMIN_CONTEXT_LIMIT=50
ROLE_PRIV_ADMIN_MAX_DOWNLOAD_MB=100

ROLE_PRIV_OWNER_MESSAGES_PER_WINDOW=-1
ROLE_PRIV_OWNER_CONTEXT_LIMIT=100
ROLE_PRIV_OWNER_MAX_DOWNLOAD_MB=-1

# ─── Web Search & Scraping ─────────────────────────────────────────────
# SearXNG instance URL used by the web_search tool.
SEARXNG_URL="https://your-searxng-instance.example.com"

# Optional: Jina.ai API Key used by the web_scrape tool.
# Get a free key at https://jina.ai/reader/ to avoid rate limits when scraping URLs.
# JINA_API_KEY="jina_your_api_key_here"

# ─── Media / Downloads ─────────────────────────────────────────────────
# Custom path to the yt-dlp binary (default: "yt-dlp" from PATH)
# YTDLP_PATH="yt-dlp"

# Maximum download file size in MB before the bot refuses to send (default: 50)
# DOWNLOAD_MAX_MB=50

# Periodic cleanup interval for cached media files in milliseconds (default: 6h)
# MEDIA_CLEANUP_INTERVAL_MS=21600000

# Delete cached media files older than this many hours (default: 72)
# MEDIA_RETENTION_HOURS=72

# Optional fixture output directory used during graceful shutdown dumps.
# Defaults to ./data/fixtures/wa_messages in production, ./test/fixtures/wa_messages otherwise.
# FIXTURE_DUMP_DIR="./data/fixtures/wa_messages"

# ─── Voice Transcription ──────────────────────────────────────────────
# URL of an external transcription service (Whisper API compatible).
# Leave unset to disable automatic voice note transcription.
# TRANSCRIBE_ENDPOINT="https://your-whisper-api.example.com/transcribe"

# Bearer token for the transcription service (optional).
# TRANSCRIBE_API_KEY=""

# Timeout for transcription requests in ms (default: 45000)
# TRANSCRIBE_TIMEOUT_MS=45000

# ─── Anonymous Confession (Menfess) ───────────────────────────────────
# Comma-separated aliases or allowed target chatIds for /menfess.
# Alias form: name:chatId
# Raw JID form: chatId
# MENFESS_TARGETS="family:120363xxx@g.us,120363yyy@g.us"

# ─── Webhook Inbound Server ───────────────────────────────────────────
# Set to "false" to disable the webhook HTTP server entirely (default: enabled).
# WEBHOOK_ENABLED=true

# Shared webhook secret. For generic webhooks send via:
# - x-webhook-secret header, or
# - JSON body field "secret", or
# - query param ?secret=
#
# For GitHub webhooks, set this and use X-Hub-Signature-256 HMAC signing.
# WEBHOOK_SECRET=""

# Port the webhook server listens on (default: 3500). Also used for /health.
WEBHOOK_PORT=3500

# Maximum character length for incoming webhook payload text (default: 3500)
# WEBHOOK_MAX_TEXT_LENGTH=3500

# Hard cap in bytes for webhook request bodies (default: 262144 = 256 KB).
# WEBHOOK_MAX_BODY_BYTES=262144

# ─── Media Services Integration (V7.15) ──────────────────────────────
# Jellyseerr/Overseerr — media request management
# SEERR_API_URL="https://your-seerr.example.com/api/v1"
# SEERR_API_KEY="your-seerr-api-key"
#
# Jellyfin — media streaming server
# JELLYFIN_API_URL="http://jellyfin.local:8096"
# JELLYFIN_API_KEY="your-jellyfin-api-key"
# JELLYFIN_EXTERNAL_URL="https://watch.example.com"  # User-facing URL for watch links
#
# Webhook secrets for inbound media service notifications (independent of WEBHOOK_SECRET).
# Seerr: In Jellyseerr webhook settings, add an Authorization header → Bearer <token>.
#   Set that same token here. Leave unset to accept without auth (not recommended).
# SEERR_WEBHOOK_SECRET=""
#
# Jellyfin: The webhook plugin has no native secret field, so leave this unset
#   to allow unauthenticated inbound webhooks (scope with network firewall rules instead).
#   If your Jellyfin plugin version supports custom headers, set it and configure
#   Authorization: Bearer <token> in the plugin as well.
# JELLYFIN_WEBHOOK_SECRET=""

# ─── Logging ───────────────────────────────────────────────────────────
# Pino log level: "trace" | "debug" | "info" | "warn" | "error" | "fatal"
# LOG_LEVEL="info"

# ─── Semantic Memory (RAG 2.0) ────────────────────────────────────────
# Optional. When EMBEDDING_API_URL and EMBEDDING_MODEL are set, long-term memories
# are embedded and ranked by cosine similarity to the current message (instead of
# pure recency), and near-duplicate memories are suppressed at write time.
# Any OpenAI-compatible embeddings endpoint works (Ollama, LM Studio, OpenAI…).
# Accepted URL forms: …/v1/embeddings (as-is), …/v1 (appended /embeddings),
# or bare host (appended /v1/embeddings).
# EMBEDDING_API_URL="http://localhost:11434/v1"
# EMBEDDING_API_KEY=""
# EMBEDDING_MODEL="text-embedding-3-small"
# EMBEDDING_TIMEOUT_MS=8000
# Candidate pool scanned per injection / dedupe check (most recent N memories):
# EMBEDDING_CANDIDATES=400
# Cosine similarity at which a new memory counts as a duplicate:
# EMBEDDING_DEDUPE_THRESHOLD=0.93
# After changing the model, re-embed old memories with: bun run db:embed

# ─── Scheduled Digests ────────────────────────────────────────────────
# Nightly per-room conversation summaries + weekly Jellyfin "new media" rollup.
# Both fire once per day/week at DIGEST_HOUR_UTC; delivery is exactly-once via
# markers in the app_kv table.
# DIGEST_ENABLED=false
# Comma-separated room ids (WhatsApp JIDs / Discord channel ids) to summarize nightly:
# DIGEST_ROOMS=""
# Hour of day (UTC) when digest jobs run:
# DIGEST_HOUR_UTC=8
# How far back the nightly summary looks, and how many messages feed the LLM:
# DIGEST_LOOKBACK_HOURS=24
# DIGEST_MAX_MESSAGES=500
# Weekly media rollup goes to rooms subscribed to jellyfin/seerr notifications
# whose notifyTypes is empty or includes "digest":
# DIGEST_MEDIA_ENABLED=false
#
# On-demand digests are always available in-chat via /digest [hours] (1-168).

# ─── Database Backups ─────────────────────────────────────────────────
# `bun run db:backup` writes consistent VACUUM INTO snapshots (db path is the
# ELASTRAX_DB_PATH set at the top of this file):
# BACKUP_DIR="./data/backups"
# BACKUP_KEEP=7
# For continuous off-site replication enable the litestream sidecar in
# docker-compose (`docker compose --profile backup up -d`) — see
# litestream.yml.example.

# ─── Runtime ───────────────────────────────────────────────────────────
# "production" disables the pretty log transport (raw JSON lines instead).
# Any other value keeps human-readable colored logs.
# NODE_ENV=development
