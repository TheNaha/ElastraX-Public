{
  "name": "elastrax-v7",
  "version": "1.0.0",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "lint": "eslint src test --max-warnings=50",
    "lint:fix": "eslint src test --fix",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/",
    "test:coverage": "bun test --coverage test/",
    "db:generate": "bun x drizzle-kit generate",
    "db:push": "bun x drizzle-kit push",
    "db:migrate": "bun x drizzle-kit migrate",
    "db:studio": "bun x drizzle-kit studio",
    "db:reset": "rm -f data/bot.db* && drizzle-kit migrate",
    "db:check": "drizzle-kit check-migrations",
    "db:embed": "bun run scripts/backfillEmbeddings.ts",
    "db:backup": "bun run scripts/dbBackup.ts",
    "fixtures:dump": "bun run scripts/dumpFixtures.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/bun": "latest",
    "@types/node": "^22.13.4",
    "@types/qrcode-terminal": "^0.12.2",
    "drizzle-kit": "^0.30.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.0.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "discord.js": "^14.25.1",
    "drizzle-orm": "^0.39.3",
    "file-type": "^21.3.0",
    "node-webpmux": "^3.2.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode-terminal": "^0.12.0"
  }
}
