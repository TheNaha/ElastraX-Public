{
  "name": "elastrax",
  "version": "8.0.1",
  "module": "src/index.ts",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "overrides": {
    "@humanfs/node": "0.16.8",
    "brace-expansion": "2.1.7",
    "esbuild": "0.25.12",
    "fast-copy": "4.1.0",
    "flatted": "3.4.4",
    "lodash": "4.18.1",
    "minimatch": "11.0.1",
    "music-metadata": "11.16.0",
    "picomatch": "4.0.7",
    "shell-quote": "1.11.0",
    "sharp": "0.35.5",
    "undici": "6.29.1",
    "ws": "8.21.3"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "check": "bun run lint && bun run typecheck && bun run test && bun run db:check",
    "lint": "eslint src test scripts --max-warnings=0",
    "lint:fix": "eslint src test --fix",
    "typecheck": "tsc --noEmit",
    "test": "bun test --no-env-file test/",
    "test:isolated": "bun test --no-env-file --isolate test/",
    "test:random": "bun test --no-env-file --isolate --randomize test/",
    "test:hermetic": "bun test --no-env-file --isolate --randomize test/",
    "test:coverage": "bun test --no-env-file --coverage test/",
    "test:webhooks": "bun test --no-env-file test/WebhookServer.test.ts test/WebhookServer.security.test.ts test/WebhookServer.media.test.ts test/WebhookConfig.test.ts test/HealthMonitor.test.ts",
    "db:generate": "bun x drizzle-kit generate",
    "db:push": "bun -e \"console.error('db:push is disabled; use db:migrate'); process.exit(1)\"",
    "db:migrate": "bun run scripts/dbBackup.ts migrate",
    "db:studio": "bun x drizzle-kit studio",
    "db:check": "bun x drizzle-kit check",
    "db:preflight": "bun run scripts/dbBackup.ts preflight",
    "db:room-keys": "bun run scripts/dbRoomKeys.ts",
    "db:room-keys:record": "bun run scripts/dbRoomKeys.ts --record-conflicts",
    "ci:diagnose": "bun run scripts/ciDiagnostics.ts",
    "provider:staging": "bun run scripts/providerStagingHarness.ts",
    "db:embed": "bun run scripts/backfillEmbeddings.ts",
    "db:backup": "bun run scripts/dbBackup.ts backup",
    "db:restore": "bun run scripts/dbBackup.ts restore",
    "db:retention": "bun run scripts/runRetention.ts",
    "fixtures:dump": "ALLOW_FIXTURE_DUMP=true NODE_ENV=test bun run scripts/dumpFixtures.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.5",
    "@types/qrcode-terminal": "^0.12.2",
    "drizzle-kit": "0.31.11",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "discord.js": "14.27.0",
    "drizzle-orm": "0.45.4",
    "file-type": "^22.2.0",
    "grammy": "^1.46.0",
    "node-webpmux": "^3.2.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "qrcode-terminal": "^0.12.0",
    "sharp": "0.35.5"
  }
}
