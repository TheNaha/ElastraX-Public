# run accidentally and should not be committed.
package-lock.json

# Project specifics
dist/
build/
.cache
.parcel-cache
coverage/
tmp/

# Runtime database and storage (do not commit local state)
data/bot.db
data/bot.db-*
data/*.db
data/*.sqlite
*.sqlite
*.db
*.sqlite-wal
*.sqlite-shm
*.db-wal
*.db-shm

# Keep Drizzle migrations tracked
!drizzle/migrations/
!drizzle/migrations/*.sql

# Env variables
.env
.env_old
.env.local
.env.development.local
.env.test.local
.env.production.local

